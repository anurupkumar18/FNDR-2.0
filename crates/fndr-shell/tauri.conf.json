{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FNDR",
  "version": "2.0.0-dev",
  "identifier": "com.fndr.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "FNDR",
        "width": 720,
        "height": 560,
        "minWidth": 520,
        "minHeight": 420,
        "resizable": true
      },
      {
        "label": "workspace",
        "title": "FNDR",
        "url": "workspace/index.html",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
